difftest-entry-points: add the difftest_* entry points the harness calls

Classification: harness plumbing.

Adds the difftest_* functions that testing/build.rs keeps global (every
other symbol of the reference is localized) and that
testing/src/bin/shared/ffi.rs calls: difftest_init() manufactures a fresh
TPM in RAM and powers it on with NV available; the difftest_signal_*()
functions forward the MSSIM platform signals and the _TPM_Hash_* indications
to the simulator's _rpc__* layer; difftest_run_command() executes one
command at a locality through _rpc__Send_Command(). difftest_advance_clock()
delivers the once-per-second ACT ticks (_plat__ACT_Tick()) of the whole
seconds of the virtual clock since the last power on that the advance
crossed, as tpm-rs counts them (the TCP simulator's ACT timer thread is not
run; the platform reads the virtual clock directly, see
harness-virtual-clock.patch).

diff --git a/TPMCmd/Simulator/src/TPMCmdp.c b/TPMCmd/Simulator/src/TPMCmdp.c
index 11fe09f..7e4c28b 100644
--- a/TPMCmd/Simulator/src/TPMCmdp.c
+++ b/TPMCmd/Simulator/src/TPMCmdp.c
@@ -240,4 +240,128 @@ void _rpc__SetTpmFirmwareSvn(uint16_t svn)
 #if SIMULATION
     _plat__SetTpmFirmwareSvn(svn);
 #endif
+}
+
+//*** tpm-rs differential testing entry points
+
+// The harness's virtual clock (see harness-virtual-clock.patch).
+extern uint64_t difftest_virtual_ms(void);
+
+// The virtual time of the last power on. The once-per-second ACT ticks
+// (_plat__ACT_Tick(), driven by a timer thread of the TCP simulator, which
+// the harness does not run) are the whole seconds of the virtual clock since
+// then, as in tpm-rs.
+static uint64_t s_difftestPowerOnMs = 0;
+
+void difftest_init(void)
+{
+    s_isPowerOn = false;
+    _plat__SetNvAvail();
+    _plat__ClearCancel();
+    _plat__Signal_PhysicalPresenceOff();
+    _plat__LocalitySet(0);
+    _plat__NVEnable(NULL, 0);
+    TPM_TearDown();
+    TPM_Manufacture(1);
+    _plat__NvCommit();
+    s_difftestPowerOnMs = difftest_virtual_ms();
+    _rpc__Signal_PowerOn(false);
+    _rpc__Signal_NvOn();
+}
+
+void difftest_advance_clock(uint64_t ms)
+{
+#if ACT_SUPPORT
+    // The virtual clock has already been advanced by ms: deliver the ticks of
+    // the whole seconds since the last power on that were crossed (they are
+    // dropped while ticks are disabled, from _TPM_Init until TPM2_Startup).
+    uint64_t now    = difftest_virtual_ms() - s_difftestPowerOnMs;
+    uint64_t before = now > ms ? now - ms : 0;
+    uint64_t ticks  = now / 1000 - before / 1000;
+    while(ticks-- > 0)
+        _plat__ACT_Tick();
+#else
+    (void)ms;
+#endif
+}
+
+void difftest_signal_power_on(void)
+{
+    if(!s_isPowerOn)
+        s_difftestPowerOnMs = difftest_virtual_ms();
+    _rpc__Signal_PowerOn(false);
+}
+
+void difftest_signal_power_off(void)
+{
+    _rpc__Signal_PowerOff();
+}
+
+void difftest_signal_reset(void)
+{
+    _rpc__Signal_PowerOn(true);
+}
+
+void difftest_signal_nv_on(void)
+{
+    _rpc__Signal_NvOn();
+}
+
+void difftest_signal_nv_off(void)
+{
+    _rpc__Signal_NvOff();
+}
+
+void difftest_signal_physical_presence_on(void)
+{
+    _rpc__Signal_PhysicalPresenceOn();
+}
+
+void difftest_signal_physical_presence_off(void)
+{
+    _rpc__Signal_PhysicalPresenceOff();
+}
+
+void difftest_signal_cancel_on(void)
+{
+    _rpc__Signal_CancelOn();
+}
+
+void difftest_signal_cancel_off(void)
+{
+    _rpc__Signal_CancelOff();
+}
+
+void difftest_signal_hash_start(void)
+{
+    _rpc__Signal_Hash_Start();
+}
+
+void difftest_signal_hash_data(const uint8_t* data, uint32_t size)
+{
+    _IN_BUFFER buf;
+    buf.BufferSize = size;
+    buf.Buffer     = (uint8_t*)data;
+    _rpc__Signal_Hash_Data(buf);
+}
+
+void difftest_signal_hash_end(void)
+{
+    _rpc__Signal_HashEnd();
+}
+
+uint32_t difftest_run_command(uint8_t        locality,
+                            const uint8_t* in_buf,
+                            uint32_t       in_size,
+                            uint8_t*       out_buf,
+                            uint32_t       out_cap)
+{
+    _IN_BUFFER  req;
+    _OUT_BUFFER resp;
+    req.BufferSize  = in_size;
+    req.Buffer      = (uint8_t*)in_buf;
+    resp.BufferSize = out_cap;
+    resp.Buffer     = out_buf;
+    _rpc__Send_Command(locality, req, &resp);
+    return resp.BufferSize;
 }
\ No newline at end of file
