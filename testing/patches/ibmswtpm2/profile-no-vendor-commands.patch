no-vendor-commands: disable the vendor commands (TCG test and Nuvoton NTC2)

Classification: profile setting.

tpm-rs implements no vendor commands, so TPM2_Vendor_TCG_Test and the
NTC2_PreConfig/LockPreConfig/GetConfig commands are configured CC_NO and
TPM_CAP_COMMANDS and TPM_PT_VENDOR_COMMANDS list none.

Ordering: generated against the tree with profile-command-list.patch applied (it
changes lines within this patch's context), so it must be applied after it;
the patches are applied in sorted file-name order.

diff --git a/src/TpmProfile_CommandList.h b/src/TpmProfile_CommandList.h
--- a/src/TpmProfile_CommandList.h
+++ b/src/TpmProfile_CommandList.h
@@ -218,7 +218,7 @@
 #define CC_StirRandom                 CC_YES
 #define CC_TestParms                  CC_YES
 #define CC_Unseal                     CC_YES
-#define CC_Vendor_TCG_Test            CC_YES
+#define CC_Vendor_TCG_Test            CC_NO  // tpm-rs differential testing: not implemented by tpm-rs
 #define CC_VerifySignature            CC_YES
 #define CC_ZGen_2Phase                CC_NO  // tpm-rs differential testing: not implemented by tpm-rs
 #define CC_NV_DefineSpace2            CC_NO  // tpm-rs differential testing: not implemented by tpm-rs
@@ -226,8 +226,8 @@
 #define CC_SetCapability              CC_NO
 
 /* kgold */
-#define CC_NTC2_PreConfig             CC_YES
-#define CC_NTC2_LockPreConfig         CC_YES
-#define CC_NTC2_GetConfig             CC_YES
+#define CC_NTC2_PreConfig             CC_NO  // tpm-rs differential testing: not implemented by tpm-rs
+#define CC_NTC2_LockPreConfig         CC_NO  // tpm-rs differential testing: not implemented by tpm-rs
+#define CC_NTC2_GetConfig             CC_NO  // tpm-rs differential testing: not implemented by tpm-rs
 
 #endif  // _TPM_PROFILE_COMMAND_LIST_H_
