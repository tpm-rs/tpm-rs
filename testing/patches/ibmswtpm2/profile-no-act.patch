no-act: build without Authenticated Countdown Timers (ACT_SUPPORT = NO)

Classification: profile setting, build fix.

tpm-rs implements no ACTs, so no TPM_RH_ACT_x handle exists. Upstream does
not build with ACT_SUPPORT = NO (ACT_spt.c is compiled out but
TPM2_GetCapability(TPM_CAP_ACT), TPM2_Startup and TPM2_Shutdown still call
into it), so those calls are guarded; without ACTs, TPM_CAP_ACT rejects
every property as mstpm20 and tpm-rs do.

diff --git a/src/CapabilityCommands.c b/src/CapabilityCommands.c
--- a/src/CapabilityCommands.c
+++ b/src/CapabilityCommands.c
@@ -191,9 +191,16 @@ TPM2_GetCapability(
 	    if(((TPM_RH)in->property < TPM_RH_ACT_0)
 	       || ((TPM_RH)in->property > TPM_RH_ACT_F))
 		return TPM_RCS_VALUE + RC_GetCapability_property;
+#if ACT_SUPPORT
 	    out->moreData = ActGetCapabilityData((TPM_HANDLE)in->property,
 						 in->propertyCount,
 						 &data->actData);
+#else
+	    // tpm-rs differential testing: ACT_SUPPORT = NO; upstream does not
+	    // build without ACT support (ACT_spt.c is compiled out). Without ACTs
+	    // no ACT handle is a valid property (as in mstpm20 and tpm-rs).
+	    return TPM_RCS_VALUE + RC_GetCapability_property;
+#endif
 	    break;
 	  case TPM_CAP_VENDOR_PROPERTY:
 	    // vendor property is not implemented
diff --git a/src/StartupCommands.c b/src/StartupCommands.c
--- a/src/StartupCommands.c
+++ b/src/StartupCommands.c
@@ -237,7 +237,9 @@ TPM2_Startup(
     // Restore/Initialize command audit information
     OK = OK && CommandAuditStartup(startup);
     // Restore the ACT
+#if ACT_SUPPORT  // tpm-rs differential testing: build without ACT support
     OK = OK && ActStartup(startup);
+#endif
     //// The following code was moved from Time.c where it made no sense
     if (OK)
 	{
@@ -331,7 +333,9 @@ TPM2_Shutdown(
     // PCR private date state save
     PCRStateSave(in->shutdownType);
     // Save the ACT state
+#if ACT_SUPPORT  // tpm-rs differential testing: build without ACT support
     ActShutdown(in->shutdownType);
+#endif
     // Save RAM backed NV index data
     NvUpdateIndexOrderlyData();
 #if ACCUMULATE_SELF_HEAL_TIMER
diff --git a/src/TpmProfile_Common.h b/src/TpmProfile_Common.h
--- a/src/TpmProfile_Common.h
+++ b/src/TpmProfile_Common.h
@@ -224,7 +224,7 @@
 //***********************************************
 // Defines controlling ACT
 //***********************************************
-#define ACT_SUPPORT                         YES
+#define ACT_SUPPORT                         NO
 #define RH_ACT_0                                (YES * ACT_SUPPORT)
 #define RH_ACT_1                                ( NO * ACT_SUPPORT)
 #define RH_ACT_2                                ( NO * ACT_SUPPORT)
