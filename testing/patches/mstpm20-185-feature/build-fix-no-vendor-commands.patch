no-vendor-commands: build the dispatcher without vendor commands

Classification: build fix.

GetVendorDispatchEntry() iterates over the vendorCommandDispatch table,
which is only included when VENDOR_COMMAND_ARRAY_COUNT > 0, so DispatchID.c
does not compile without vendor commands (see profile-no-vendor-commands).
Without them the function finds no entry.
diff --git a/TPMCmd/tpm/src/support/DispatchID.c b/TPMCmd/tpm/src/support/DispatchID.c
--- a/TPMCmd/tpm/src/support/DispatchID.c
+++ b/TPMCmd/tpm/src/support/DispatchID.c
@@ -105,6 +105,7 @@
 
 BOOL GetVendorDispatchEntry(TPM_CC code, DispatchEntry* entry, VendorCommandHandler* handler)
 {
+#if VENDOR_COMMAND_ARRAY_COUNT > 0
     for(unsigned int i = 0; i < ARRAYSIZE(vendorCommandDispatch); i++)
     {
         const VendorDispatchId* vid = &vendorCommandDispatch[i];
@@ -120,5 +121,12 @@
             return TRUE;
         }
     }
+#else
+    // tpm-rs differential testing (build fix): without vendor commands there
+    // is no vendorCommandDispatch table.
+    NOT_REFERENCED(code);
+    NOT_REFERENCED(entry);
+    NOT_REFERENCED(handler);
+#endif  // VENDOR_COMMAND_ARRAY_COUNT > 0
     return FALSE;
 }
