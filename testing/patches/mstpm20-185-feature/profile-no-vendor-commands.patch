+++ b/TPMCmd/TpmConfiguration/TpmConfiguration/VendorCommands/VendorCommandList.h
@@ -7,7 +7,8 @@
 #  error This file should be included only within TpmProfile_CommandList.h
 #endif
 
-#define CC_Vendor_TCG_Test CC_YES
