     if(in->hint.t.size != 0 && !VerifySequenceSchemeTakesHint(scheme.scheme))
         return TPM_RCS_VALUE + RC_VerifySequenceStart_hint;
 
+    // tpm-rs differential testing -- C-ref spec deviation fix (NOT determinism):
+    // the TPM_ST_MESSAGE_VERIFIED ticket of TPM2_VerifySequenceComplete() is an
+    // HMAC over the message, so it runs alongside the sequence, keyed with the
+    // proof of the key's hierarchy (a NULL Ticket for a key in TPM_RH_NULL or
+    // with nameAlg TPM_ALG_NULL). The proof is obtained before the sequence is
+    // created, so that its error (TPM_RC_FW_LIMITED, TPM_RC_SVN_LIMITED) leaves
+    // the TPM unchanged.
+    ticketHierarchy = GetHierarchy(in->keyHandle);
+    if(signObject->publicArea.nameAlg == TPM_ALG_NULL)
+        ticketHierarchy = TPM_RH_NULL;
+    if(ticketHierarchy != TPM_RH_NULL)
+    {
+        result = HierarchyGetProof(ticketHierarchy, &proof);
+        if(result != TPM_RC_SUCCESS)
+            return result;
+    }
+
     // Internal Data Update and Command Output
     // NOTE: Authorization of 'keyHandle' is not required here. It is checked
     // when TPM2_VerifySequenceComplete() is called.
-    return ObjectCreateVerifySequence(
+    result = ObjectCreateVerifySequence(
         signObject, &scheme, &in->auth, &in->context, &out->sequenceHandle);
+    if(result == TPM_RC_SUCCESS)
+    {
+        SEQUENCE_OBJECT* sequenceObject =
+            (SEQUENCE_OBJECT*)HandleToObject(out->sequenceHandle);
+        //
+        sequenceObject->ticketHierarchy = ticketHierarchy;
+        if(ticketHierarchy != TPM_RH_NULL)
+        {
+            CryptoCommon_HmacStart2B(&sequenceObject->state.verify.ticket,
+                                     CONTEXT_INTEGRITY_HASH_ALG,
+                                     &proof.b);
+            CryptoCommon_DigestUpdateInt(&sequenceObject->state.verify.ticket,
+                                         sizeof(TPM_ST),
+                                         TPM_ST_MESSAGE_VERIFIED);
+        }
+    }
+    if(ticketHierarchy != TPM_RH_NULL)
+        MemorySet(proof.b.buffer, 0, proof.b.size);
+    return result;
 }
 
