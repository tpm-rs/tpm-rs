+    // TPMT_TK_VERIFIED), in 'state.verify.ticket', keyed with the proof of
+    // 'ticketHierarchy', the hierarchy of the key when the sequence was started.
+    // TPM_RH_NULL means a NULL Ticket and no running ticket HMAC.
+    TPMI_RH_HIERARCHY ticketHierarchy;
     union
