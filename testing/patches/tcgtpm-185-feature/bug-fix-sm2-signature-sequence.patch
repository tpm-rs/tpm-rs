-            return FALSE;
-#  endif  // ALG_SM2
+        // tpm-rs differential testing -- C-ref spec deviation fix (NOT determinism):
+        // SM2 is supported: the sequence hashes Z_A (computed with 'context' as
+        // ID_A) before the message, so TPM2_VerifySequenceComplete() verifies
