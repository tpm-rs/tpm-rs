sm2-signature-sequence: SM2 signing and verification sequences use context as ID_A

Classification: spec-deviation bug fix.

Specification (TPM 2.0 Library, Part 3 (version 185), Table "Signing commands
overview"):

  "SM2 | Message (see Note) | ... | TPM2_SignSequenceComplete()/
  TPM2_VerifySequenceComplete(): Signs/verifies the message using the provided
  context as ID_A"

Specification (TPM 2.0 Library, Part 1 (version 185), "SM2 Sign"):

  "Z_A := H(ENTL_A || ID_A || a || b || x_G || y_G || x_A || y_A)" ...
  "ENTL_A is two octets containing the length of ID_A in octets" ...
  "e := H(Z_A || M)"

Specification (TPM 2.0 Library, Part 2 (version 185), "TPMU_SIGNATURE_CTX"):

  "id[MAX_SM2_ID_BYTES] | BYTE | TPM_ALG_SM2 | Value for ID_A"

TPM2_SignSequenceStart and TPM2_VerifySequenceStart reject keys whose scheme
is TPM_ALG_SM2 with TPM_RC_SCHEME ("185TODO"), and the reference's
TPMU_SIGNATURE_CTX has no SM2 member, so a TPM2B_SIGNATURE_CTX cannot hold an
ID_A. SM2 is now accepted by both commands, with any context as ID_A: the
sequence's running hash (the scheme's hash H) starts with Z_A, computed from
ENTL_A (the length of ID_A in octets, 2 octets big-endian), ID_A, the curve's
a, b, x_G and y_G and the key's x_A and y_A, each left-padded to the size of
the field, so that TPM2_SignSequenceComplete/TPM2_VerifySequenceComplete sign
or verify the SM2 internal digest e = H(Z_A || M). TPMU_SIGNATURE_CTX gets the
id[MAX_SM2_ID_BYTES] member (MAX_SM2_ID_BYTES = 255), which is also the bound
of a TPM2B_SIGNATURE_CTX with SM2 and without ML-DSA. As in tpm-rs.
diff --git a/TPMCmd/tpm/include/tpm_public/TpmAlgorithmDefines.h b/TPMCmd/tpm/include/tpm_public/TpmAlgorithmDefines.h
--- a/TPMCmd/tpm/include/tpm_public/TpmAlgorithmDefines.h
+++ b/TPMCmd/tpm/include/tpm_public/TpmAlgorithmDefines.h
@@ -232,12 +232,19 @@
 #  define MAX_SIGNATURE_HINT_SIZE 1
 #endif
 
+// tpm-rs differential testing -- C-ref spec deviation fix (NOT determinism):
+// the size of the ID_A of SM2 in a TPMU_SIGNATURE_CTX (Part 2,
+// "id[MAX_SM2_ID_BYTES]"), which also bounds a TPM2B_SIGNATURE_CTX with SM2.
+#define MAX_SM2_ID_BYTES 255
+
 // 185TODO: Incorporate DAA context size into the calculation of MAX_SIG_CTX_SIZE.
 // tpm-rs differential testing -- C-ref spec deviation fix (NOT determinism):
 // a TPM2B_SIGNATURE_CTX holds up to sizeof(TPMU_SIGNATURE_CTX) octets (Part 2),
 // which is sizeof(UINT16) (commitCount) for ECDAA without ML-DSA.
 #if ALG_MLDSA
 #  define MAX_SIG_CTX_SIZE MLDSA_CTX_MAX_SIZE
+#elif ALG_SM2
+#  define MAX_SIG_CTX_SIZE MAX_SM2_ID_BYTES
 #elif ALG_ECDAA
 #  define MAX_SIG_CTX_SIZE 2
 #else
diff --git a/TPMCmd/tpm/include/tpm_public/TpmTypes.h b/TPMCmd/tpm/include/tpm_public/TpmTypes.h
--- a/TPMCmd/tpm/include/tpm_public/TpmTypes.h
+++ b/TPMCmd/tpm/include/tpm_public/TpmTypes.h
@@ -2344,6 +2344,11 @@ typedef union
 #if ALG_ECDAA
     BYTE commitCount[sizeof(UINT16)];
 #endif  // ALG_ECDAA
+#if ALG_SM2
+    // tpm-rs differential testing -- C-ref spec deviation fix (NOT determinism):
+    // the ID_A of SM2 (Part 2, TPMU_SIGNATURE_CTX).
+    BYTE id[MAX_SM2_ID_BYTES];
+#endif  // ALG_SM2
 #if ALG_MLDSA || ALG_HASH_MLDSA
     BYTE buffer[MLDSA_CTX_MAX_SIZE];
 #endif  // ALG_MLDSA || ALG_HASH_MLDSA
diff --git a/TPMCmd/tpm/src/command/Signature/SignSequenceStart.c b/TPMCmd/tpm/src/command/Signature/SignSequenceStart.c
--- a/TPMCmd/tpm/src/command/Signature/SignSequenceStart.c
+++ b/TPMCmd/tpm/src/command/Signature/SignSequenceStart.c
@@ -19,6 +19,13 @@ static BOOL SignSequenceSchemeTakesContext(TPM_ALG_ID scheme)
         case TPM_ALG_MLDSA:
             return TRUE;
 #  endif  // ALG_MLDSA
+#  if ALG_SM2
+        // tpm-rs differential testing -- C-ref spec deviation fix (NOT determinism):
+        // SM2 "Signs/verifies the message using the provided context as ID_A"
+        // (Part 3, Table "Signing commands overview").
+        case TPM_ALG_SM2:
+            return TRUE;
+#  endif  // ALG_SM2
         default:
             return FALSE;
     }
@@ -57,15 +64,10 @@ static BOOL SelectSignSequenceScheme(OBJECT*          signObject,  // IN: signin
 
     switch(scheme->scheme)
     {
-#  if ALG_SM2
-        case TPM_ALG_SM2:
-            // 185TODO: TPM2_SignSequenceComplete() is required to sign the
-            // message itself with SM2, using 'context' as the identity value
-            // (ID_A). The crypto layer can only sign an SM2 internal digest 'e'
-            // that has already been computed, so reject SM2 keys for now rather
-            // than sign the wrong value.
-            return FALSE;
-#  endif  // ALG_SM2
+        // tpm-rs differential testing -- C-ref spec deviation fix (NOT determinism):
+        // SM2 is supported: the sequence hashes Z_A (computed with 'context' as
+        // ID_A) before the message, so TPM2_SignSequenceComplete() signs the
+        // SM2 internal digest e (ObjectCreateSignSequence()).
         default:
             return TRUE;
     }
diff --git a/TPMCmd/tpm/src/command/Signature/VerifySequenceStart.c b/TPMCmd/tpm/src/command/Signature/VerifySequenceStart.c
--- a/TPMCmd/tpm/src/command/Signature/VerifySequenceStart.c
+++ b/TPMCmd/tpm/src/command/Signature/VerifySequenceStart.c
@@ -19,6 +19,13 @@ static BOOL VerifySequenceSchemeTakesContext(TPM_ALG_ID scheme)
         case TPM_ALG_MLDSA:
             return TRUE;
 #  endif  // ALG_MLDSA
+#  if ALG_SM2
