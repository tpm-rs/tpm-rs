diff --git a/TPMCmd/tpm/src/subsystem/Object.c b/TPMCmd/tpm/src/subsystem/Object.c
--- a/TPMCmd/tpm/src/subsystem/Object.c
+++ b/TPMCmd/tpm/src/subsystem/Object.c
@@ -606,6 +606,63 @@ ObjectCreateEventSequence(TPM2B_AUTH*     auth,      // IN: authValue
     return TPM_RC_SUCCESS;
 }
 
+#if ALG_SM2 && (CC_SignSequenceStart || CC_VerifySequenceStart)
+//*** ObjectSm2DigestZa()
+// tpm-rs differential testing -- C-ref spec deviation fix (NOT determinism):
+// adds Z_A of an SM2 signing or verification sequence to its running hash
+// (Part 1, "SM2 Sign": Z_A := H(ENTL_A || ID_A || a || b || x_G || y_G || x_A ||
+// y_A), "ENTL_A is two octets containing the length of ID_A in octets", and
+// e := H(Z_A || M)), with 'context' as ID_A and each field element in
+// big-endian form with the size of the field.
+//  Return Type: TPM_RC
+//      TPM_RC_FAILURE              the curve parameters could not be read
+static TPM_RC ObjectSm2DigestZa(
+    HASH_STATE*          hashState,  // IN/OUT: the running hash of the sequence
+    TPMI_ALG_HASH        hashAlg,    // IN: the hash of the scheme
+    OBJECT*              signKey,    // IN: the SM2 key
+    TPM2B_SIGNATURE_CTX* id          // IN: ID_A
+)
+{
+    TPM_ECC_CURVE curveId = signKey->publicArea.parameters.eccDetail.curveID;
+    UINT16        size    = BITS_TO_BYTES(CryptoEcc_GetKeySizeForCurve(curveId));
+    TPMS_ALGORITHM_DETAIL_ECC curve;
+    TPM2B_ECC_PARAMETER*      values[6];
+    TPM2B_ECC_PARAMETER       element;
+    HASH_STATE                zaState;
+    TPM2B_DIGEST              za;
+    int                       i;
+    //
+    MemorySet(&curve, 0, sizeof(curve));
+    if(!CryptoEcc_GetParameters(curveId, &curve) || size == 0
+       || size > sizeof(element.t.buffer))
+        return TPM_RC_FAILURE;
+    values[0] = &curve.a;
+    values[1] = &curve.b;
+    values[2] = &curve.gX;
+    values[3] = &curve.gY;
+    values[4] = &signKey->publicArea.unique.ecc.x;
+    values[5] = &signKey->publicArea.unique.ecc.y;
+    CryptoHash_HashStart(&zaState, hashAlg);
+    CryptoCommon_DigestUpdateInt(&zaState, sizeof(UINT16), id->t.size);
+    CryptoCommon_DigestUpdate2B(&zaState, &id->b);
+    for(i = 0; i < 6; i++)
+    {
+        // Left-pad each value to the size of the field.
+        if(values[i]->t.size > size)
+            return TPM_RC_FAILURE;
+        element.t.size = size;
+        MemorySet(element.t.buffer, 0, size);
+        MemoryCopy(&element.t.buffer[size - values[i]->t.size],
+                   values[i]->t.buffer,
+                   values[i]->t.size);
+        CryptoCommon_DigestUpdate2B(&zaState, &element.b);
+    }
+    za.t.size = CryptoHash_HashEnd(&zaState, sizeof(za.t.buffer), za.t.buffer);
+    CryptoCommon_DigestUpdate2B(hashState, &za.b);
+    return TPM_RC_SUCCESS;
+}
+#endif  // ALG_SM2 && (CC_SignSequenceStart || CC_VerifySequenceStart)
+
 #if CC_SignSequenceStart
 //*** ObjectCreateSignSequence()
 // This function creates a signing sequence object.
@@ -668,6 +725,15 @@ ObjectCreateSignSequence(
             // accumulates the message into a running hash.
             CryptoHash_HashStart(&sequenceObject->state.hashState[0],
                                  CryptoCommon_GetSignSchemeHashAlg(scheme));
+#  if ALG_SM2
+            // tpm-rs differential testing -- C-ref spec deviation fix (NOT determinism):
+            // an SM2 sequence computes e = H(Z_A || M).
+            if(scheme->scheme == TPM_ALG_SM2)
+                result = ObjectSm2DigestZa(&sequenceObject->state.hashState[0],
+                                           CryptoCommon_GetSignSchemeHashAlg(scheme),
+                                           signKey,
+                                           context);
+#  endif  // ALG_SM2
             break;
     }
     if(result != TPM_RC_SUCCESS)
@@ -776,6 +842,15 @@ ObjectCreateVerifySequence(
             // accumulates the message into a running hash.
             CryptoHash_HashStart(&sequenceObject->state.hashState[0],
                                  CryptoCommon_GetSignSchemeHashAlg(scheme));
+#  if ALG_SM2
+            // tpm-rs differential testing -- C-ref spec deviation fix (NOT determinism):
+            // an SM2 sequence computes e = H(Z_A || M).
+            if(scheme->scheme == TPM_ALG_SM2)
+                result = ObjectSm2DigestZa(&sequenceObject->state.hashState[0],
+                                           CryptoCommon_GetSignSchemeHashAlg(scheme),
+                                           signKey,
+                                           context);
+#  endif  // ALG_SM2
             break;
     }
     if(result != TPM_RC_SUCCESS)
