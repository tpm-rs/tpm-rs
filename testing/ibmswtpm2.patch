+//*** difftest_install_injected_secret()
+// tpm-rs differential testing. Installs implementation-defined secret key
+// material produced by tpm-rs (RSA prime and modulus, ECC private scalar,
+// TPM-generated symmetric/keyed-hash key, seedValue) into 'newObject'. Only
+// values that are random or vendor-defined are taken; everything else (public
+// area, authValue, caller-provided sensitive data, whether a seedValue exists)
+// stays as computed by the reference code. The reference code verifies the
+// injected material and recomputes the public 'unique' field and the Name:
+//  - RSA: CryptRsaLoadPrivateExponent() checks that the prime divides n;
+//  - ECC: the public point is recomputed as [d]G;
+//  - SYMCIPHER/KEYEDHASH: 'unique' is recomputed by CryptComputeSymmetricUnique().
+// Returns FALSE (leaving the object without valid key material, so that the
+// response mismatches loudly) if the injected material is rejected.
+static BOOL difftest_install_injected_secret(OBJECT*                     newObject,
+                                           const TPM2B_PUBLIC_KEY_RSA* rsaModulus,
+                                           const BYTE*                 privKey,
+                                           UINT16                      privKeySize,
+                                           const BYTE*                 seed,
+                                           UINT16                      seedSize,
+                                           UINT16 callerDataSize)
+{
+    TPMT_PUBLIC*    publicArea = &newObject->publicArea;
+    TPMT_SENSITIVE* sensitive  = &newObject->sensitive;
+    BOOL            ok         = TRUE;
+
+    // seedValue is random; only replace its contents if the reference code
+    // itself decided that the object has a seedValue of this size.
+    if(seed != NULL && seedSize != 0 && sensitive->seedValue.t.size == seedSize)
+        MemoryCopy(sensitive->seedValue.t.buffer, seed, seedSize);
+
+    switch(publicArea->type)
+    {
+#if ALG_RSA
+        case TPM_ALG_RSA:
+            if(rsaModulus == NULL || privKey == NULL
+               || rsaModulus->t.size != BITS_TO_BYTES(publicArea->parameters.rsaDetail.keyBits)
+               || (UINT32)privKeySize * 2 != rsaModulus->t.size)
+            {
+                ok = FALSE;
+                break;
+            }
+            publicArea->unique.rsa = *rsaModulus;
+            sensitive->sensitive.rsa.t.size = privKeySize;
+            MemoryCopy(sensitive->sensitive.rsa.t.buffer, privKey, privKeySize);
+            ok = (CryptRsaLoadPrivateExponent(publicArea, sensitive) == TPM_RC_SUCCESS);
+            break;
+#endif
+#if ALG_ECC
+        case TPM_ALG_ECC:
+        {
+            TPM2B_ECC_PARAMETER d;
+            TPMS_ECC_POINT      q;
+            if(privKey == NULL || privKeySize == 0 || privKeySize > sizeof(d.t.buffer))
+            {
+                ok = FALSE;
+                break;
+            }
+            d.t.size = privKeySize;
+            MemoryCopy(d.t.buffer, privKey, privKeySize);
+            if(CryptEccPointMultiply(
+                   &q, publicArea->parameters.eccDetail.curveID, NULL, &d, NULL, NULL)
+               != TPM_RC_SUCCESS)
+            {
+                ok = FALSE;
+                break;
+            }
+            sensitive->sensitive.ecc = d;
+            publicArea->unique.ecc   = q;
+            break;
+        }
+#endif
+        case TPM_ALG_SYMCIPHER:
+        case TPM_ALG_KEYEDHASH:
+            // Only TPM-generated keys are random (the reference code generates
+            // the key whenever no caller data is supplied, see
+            // CryptGenerateKeyedHash()/CryptGenerateKeySymmetric());
+            // caller-provided keys are kept.
+            if(callerDataSize == 0 && privKey != NULL
+               && privKeySize == sensitive->sensitive.any.t.size)
+                MemoryCopy(sensitive->sensitive.any.t.buffer, privKey, privKeySize);
+            CryptComputeSymmetricUnique(publicArea, sensitive, &publicArea->unique.sym);
+            break;
+        default:
+            break;
+    }
+    if(!ok)
+        MemorySet(&publicArea->unique, 0, sizeof(publicArea->unique));
+    PublicMarshalAndComputeName(publicArea, &newObject->name);
+    return ok;
+}
+
+//*** difftest_sync_ordinary_object()
+// tpm-rs differential testing. For an ordinary object created by TPM2_Create or
+// TPM2_CreateLoaded, takes tpm-rs's recorded outPublic/outPrivate, unwraps the
+// private area with the reference code's own copy of the parent (which checks
+// the integrity and binding of tpm-rs's blob to its public area), and installs
+// only its random/implementation-defined secrets via
+// difftest_install_injected_secret(). The outer-wrap IV of the recorded blob is
+// reused (random input) so that the reference code's own re-wrap is comparable.
+void difftest_sync_ordinary_object(OBJECT* parent, OBJECT* newObject, UINT16 callerDataSize)
+{
+    UINT16 pub_size  = 0;
+    UINT16 priv_size = 0;
+    BYTE   pub_buf[sizeof(TPM2B_PUBLIC)];
+    BYTE   priv_buf[sizeof(TPM2B_PRIVATE)];
+
+    s_sync_outer_iv_size = 0;
+    if(parent == NULL
+       || !difftest_get_recorded_ordinary_object(&pub_size, pub_buf, &priv_size, priv_buf)
+       || pub_size == 0 || priv_size == 0)
+        return;
+
+    BYTE*        p   = pub_buf;
+    INT32        rem = (INT32)pub_size;
+    TPM2B_PUBLIC inPub;
+    TPM2B_NAME   recName;
+    if(TPM2B_PUBLIC_Unmarshal(&inPub, &p, &rem, FALSE) != TPM_RC_SUCCESS
+       || inPub.publicArea.type != newObject->publicArea.type)
+        return;
+    PublicMarshalAndComputeName(&inPub.publicArea, &recName);
+
+    difftest_decrypt_recorded_response_2b((INT32)priv_size, priv_buf);
+    p   = priv_buf;
+    rem = (INT32)priv_size;
+    TPM2B_PRIVATE  inPriv;
+    TPMT_SENSITIVE sens;
+    if(TPM2B_PRIVATE_Unmarshal(&inPriv, &p, &rem) != TPM_RC_SUCCESS)
+        return;
+    UINT16 integritySize =
+        sizeof(UINT16) + CryptHashGetDigestSize(parent->publicArea.nameAlg);
+    UINT16 ivSize = GetIV2BSize(parent);
+    if(ivSize > sizeof(UINT16) && inPriv.t.size >= integritySize + ivSize)
+    {
+        s_sync_outer_iv_size = ivSize - sizeof(UINT16);
+        MemoryCopy(s_sync_outer_iv,
+                   inPriv.t.buffer + integritySize + sizeof(UINT16),
+                   s_sync_outer_iv_size);
+    }
+    if(PrivateToSensitive(
+           &inPriv.b, &recName.b, parent, newObject->publicArea.nameAlg, &sens)
+       != TPM_RC_SUCCESS)
+        return;
+    difftest_install_injected_secret(newObject,
+                                   &inPub.publicArea.unique.rsa,
+                                   sens.sensitive.any.t.buffer,
+                                   sens.sensitive.any.t.size,
+                                   sens.seedValue.t.buffer,
+                                   sens.seedValue.t.size,
+                                   callerDataSize);
+}
+
+//*** difftest_sync_primary_object()
+// tpm-rs differential testing. Primary-object generation from a hierarchy seed
+// is a vendor option (TPM 2.0 Part 1, "Entropy for Primary Objects"), so the
+// harness computes tpm-rs's primary secrets from the same hierarchy seed,
+// template Name and sensitive data, and the reference code installs and
+// verifies them via difftest_install_injected_secret(). Derived objects
+// (TPM2_CreateLoaded with a derivation parent) are spec-defined and are never
+// synchronized.
+void difftest_sync_primary_object(TPMI_RH_HIERARCHY     primaryHandle,
+                                OBJECT*               newObject,
+                                TPM2B_NAME*           templateName,
+                                TPM2B_SENSITIVE_DATA* sensitiveData,
+                                UINT16                callerDataSize)
+{
+    TPM2B_SEED hier_seed;
+    UINT32     attrs    = 0;
+    UINT16     key_bits = 0;
+    BYTE       seed_val[64];
+    UINT16     seed_val_size = 0;
+    BYTE       priv_key[512];
+    UINT16     priv_key_size = 0;
+    BYTE       uniq_x[512];
+    UINT16     uniq_x_size = 0;
+    BYTE       uniq_y[128];
+    UINT16     uniq_y_size = 0;
+
+    if(HierarchyGetPrimarySeed(primaryHandle, &hier_seed) != TPM_RC_SUCCESS)
+        return;
+    MemoryCopy(&attrs, &newObject->publicArea.objectAttributes, sizeof(UINT32));
+
+    switch(newObject->publicArea.type)
+    {
+        case TPM_ALG_RSA:
+            key_bits = newObject->publicArea.parameters.rsaDetail.keyBits;
+            break;
+        case TPM_ALG_ECC:
+            key_bits = newObject->publicArea.parameters.eccDetail.curveID;
+            break;
+        case TPM_ALG_SYMCIPHER:
+            key_bits = newObject->publicArea.parameters.symDetail.sym.keyBits.sym;
+            break;
+        default:
+            key_bits = 0;
+            break;
+    }
+
+    if(!difftest_derive_object(newObject->publicArea.nameAlg,
+                             hier_seed.t.buffer,
+                             hier_seed.t.size,
+                             (const BYTE*)"Primary Object Creation",
+                             23,
+                             templateName->b.buffer,
+                             templateName->b.size,
+                             sensitiveData ? sensitiveData->t.buffer : NULL,
+                             sensitiveData ? sensitiveData->t.size : 0,
+                             newObject->publicArea.type,
+                             newObject->publicArea.nameAlg,
+                             attrs,
+                             key_bits,
+                             sensitiveData ? sensitiveData->t.buffer : NULL,
+                             sensitiveData ? sensitiveData->t.size : 0,
+                             seed_val,
+                             &seed_val_size,
+                             priv_key,
+                             &priv_key_size,
+                             uniq_x,
+                             &uniq_x_size,
+                             uniq_y,
+                             &uniq_y_size))
+        return;
+
+    TPM2B_PUBLIC_KEY_RSA modulus;
+    modulus.t.size = 0;
+    if(uniq_x_size <= sizeof(modulus.t.buffer))
+    {
+        modulus.t.size = uniq_x_size;
+        MemoryCopy(modulus.t.buffer, uniq_x, uniq_x_size);
