+//*** difftest_decrypt_recorded_response_2b()
+// tpm-rs differential testing. Decrypts a recorded first-parameter TPM2B in
+// place if the current command uses a response encryption session
+// (`s_encryptSessionIndex != UNDEFINED_INDEX`), so that values recorded from
+// tpm-rs's (encrypted) response can be verified and adopted.
+void difftest_decrypt_recorded_response_2b(INT32 bufferSize, BYTE* buffer)
+{
+    if(s_encryptSessionIndex == UNDEFINED_INDEX || buffer == NULL || bufferSize < 2)
+        return;
+
+    SESSION* session = SessionGet(s_sessionHandles[s_encryptSessionIndex]);
+    if(session == NULL)
+        return;
+
+    UINT32 nonceIndex = 0;
+    UINT32 i;
+    for(i = 0; i < s_encryptSessionIndex; i++)
+    {
+        if(s_sessionHandles[i] != TPM_RS_PW)
+            nonceIndex++;
+    }
+
+    TPM2B_NONCE newNonce;
+    newNonce.t.size = session->nonceTPM.t.size;
+    if(!difftest_peek_nonce(nonceIndex, newNonce.t.size, newNonce.t.buffer))
+        return;
+
+    TPM2B_AUTH extraKey;
+    extraKey.b.size = 0;
+    if(s_associatedHandles[s_encryptSessionIndex] != TPM_RH_UNASSIGNED)
+    {
+        EntityGetAuthValue(s_associatedHandles[s_encryptSessionIndex], &extraKey);
+    }
+
+    TPM2B_TYPE(TEMP_KEY,
+               (sizeof(extraKey.t.buffer) + sizeof(session->sessionKey.t.buffer)));
+    TPM2B_TEMP_KEY key;
+    UINT16         cipherSize = 0;
+    if(UINT16_Unmarshal(&cipherSize, &buffer, &bufferSize) != TPM_RC_SUCCESS)
+        return;
+    if(cipherSize > bufferSize)
+        return;
+
+    MemoryCopy2B(&key.b, &session->sessionKey.b, sizeof(key.t.buffer));
+    MemoryConcat2B(&key.b, &extraKey.b, sizeof(key.t.buffer));
+
+    if(session->symmetric.algorithm == TPM_ALG_XOR)
+    {
+        CryptXORObfuscation(session->authHashAlg,
+                            &key.b,
+                            &newNonce.b,
+                            &s_nonceCaller[s_encryptSessionIndex].b,
+                            (UINT32)cipherSize,
+                            buffer);
+    }
+    else
+    {
+        ParmDecryptSym(session->symmetric.algorithm,
+                       session->authHashAlg,
+                       session->symmetric.keyBits.sym,
+                       &key.b,
+                       &newNonce.b,
+                       &s_nonceCaller[s_encryptSessionIndex].b,
+                       (UINT32)cipherSize,
+                       buffer);
+    }
+}
