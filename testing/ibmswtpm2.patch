+//*** difftest_startup_rng()
+// tpm-rs differential testing (RNG-stream alignment). Draws the TPM Reset
+// values nullSeed, nullProof and commitNonce (generated upstream by
+// HierarchyStartup() and CryptStartup()) from the platform RNG stream shared
+// with tpm-rs, in tpm-rs's order, and then consumes as many bytes as tpm-rs's
+// DRBG (re)seeding does at TPM2_Startup so that later draws stay aligned.
+void difftest_startup_rng(STARTUP_TYPE startup)
+{
+    BYTE dummy[64];
+    if(startup == SU_RESET)
+    {
+        gr.nullSeed.t.size = sizeof(gr.nullSeed.t.buffer);
+        difftest_plat_rng_fill(gr.nullSeed.t.buffer, gr.nullSeed.t.size);
+        gr.nullProof.t.size = sizeof(gr.nullProof.t.buffer);
+        difftest_plat_rng_fill(gr.nullProof.t.buffer, gr.nullProof.t.size);
+        gr.commitNonce.t.size = sizeof(gr.commitNonce.t.buffer);
+        difftest_plat_rng_fill(gr.commitNonce.t.buffer, gr.commitNonce.t.size);
+    }
+    if(IS_ORDERLY(g_prevOrderlyState) && go.drbgState.magic == DRBG_MAGIC)
+    {
+        difftest_plat_rng_fill(dummy, 48);
+    }
+    else
+    {
+        difftest_plat_rng_fill(dummy, 64);
+    }
+}
