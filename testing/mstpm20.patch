+//*** tpm-rs differential testing entry points
+extern void difftest_entropy_reset(void);
+
+void difftest_init(void)
+{
+    s_isPowerOn = false;
+    difftest_entropy_reset();
+    _plat__SetNvAvail();
+    _plat__ClearCancel();
+    _plat__Signal_PhysicalPresenceOff();
+    _plat__LocalitySet(0);
+    _plat__NVEnable(NULL, 0);
+    TPM_TearDown();
+    TPM_Manufacture(1);
+    _plat__NvCommit();
+    _rpc__Signal_PowerOn(false);
+    _rpc__Signal_NvOn();
+}
+
+void difftest_advance_clock(uint64_t ms)
+{
+    (void)ms;
+}
+
+void difftest_signal_power_on(void)
+{
+    _rpc__Signal_PowerOn(false);
+}
+
+void difftest_signal_power_off(void)
+{
+    _rpc__Signal_PowerOff();
+}
+
+void difftest_signal_reset(void)
+{
+    _rpc__Signal_PowerOn(true);
+}
+
+void difftest_signal_nv_on(void)
+{
+    _rpc__Signal_NvOn();
+}
+
+void difftest_signal_nv_off(void)
+{
+    _rpc__Signal_NvOff();
+}
+
+void difftest_signal_physical_presence_on(void)
+{
+    _rpc__Signal_PhysicalPresenceOn();
+}
+
+void difftest_signal_physical_presence_off(void)
+{
+    _rpc__Signal_PhysicalPresenceOff();
+}
+
+void difftest_signal_cancel_on(void)
+{
+    _rpc__Signal_CancelOn();
+}
+
+void difftest_signal_cancel_off(void)
+{
+    _rpc__Signal_CancelOff();
+}
+
+void difftest_signal_hash_start(void)
+{
+    _rpc__Signal_Hash_Start();
+}
+
+void difftest_signal_hash_data(const uint8_t* data, uint32_t size)
+{
+    _IN_BUFFER buf;
+    buf.BufferSize = size;
+    buf.Buffer     = (uint8_t*)data;
+    _rpc__Signal_Hash_Data(buf);
+}
+
+void difftest_signal_hash_end(void)
+{
+    _rpc__Signal_HashEnd();
+}
+
+uint32_t difftest_run_command(uint8_t        locality,
+                            const uint8_t* in_buf,
+                            uint32_t       in_size,
+                            uint8_t*       out_buf,
+                            uint32_t       out_cap)
+{
+    _IN_BUFFER  req;
+    _OUT_BUFFER resp;
+    req.BufferSize  = in_size;
+    req.Buffer      = (uint8_t*)in_buf;
+    resp.BufferSize = out_cap;
+    resp.Buffer     = out_buf;
+    _rpc__Send_Command(locality, req, &resp);
+    return resp.BufferSize;
 }
